#!/usr/bin/env bash
set -euo pipefail

pax_notes_vault="${PAX_NOTES_VAULT:-$HOME/projects/notes}"
pax_org_notes_root="${PAX_ORG_NOTES_ROOT:-$pax_notes_vault/org}"
pax_org_daily_dir="$pax_org_notes_root/daily"
pax_work_dir="${PAX_OBSIDIAN_WORK_DIR:-$pax_notes_vault/Work}"
pax_current_file="$pax_work_dir/Current Work Briefing.md"
pax_candidates_file="$pax_work_dir/Knowledge Candidates.md"
pax_weekly_dir="$pax_work_dir/Weekly"
pax_org_repo="${PAX_ORG_PAX_ROOT:-$HOME/pax}"
pax_org_limit="${PAX_ORG_DAILY_LIMIT:-10}"
pax_org_model="${PAX_ORG_DAILY_MODEL:-landfolk-openai-codex/gpt-5.6-luna:medium}"

pax_org_mode="current"
pax_org_week=""
pax_org_prompt_only=0
pax_org_force=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --weekly)
      pax_org_mode="weekly"
      if [ "${2:-}" != "" ] && [[ "$2" =~ ^[0-9]{4}-W[0-9]{2}$ ]]; then
        pax_org_week="$2"
        shift
      fi
      ;;
    --prompt-only) pax_org_prompt_only=1 ;;
    --force) pax_org_force=1 ;;
    --help)
      printf '%s\n' \
        'Usage: org-daily-brief [--prompt-only] [--weekly [YYYY-Www]] [--force]' \
        '' \
        'Default: update the rolling Obsidian briefing and knowledge candidates.' \
        '--weekly: synthesize the previous completed ISO week, or the supplied week.' \
        '--force: replace an existing weekly snapshot.'
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [ ! -d "$pax_org_daily_dir" ]; then
  echo "No daily-note directory at $pax_org_daily_dir" >&2
  exit 2
fi

pax_org_week_for_date() {
  date -j -f '%Y-%m-%d' "$1" '+%G-W%V' 2>/dev/null ||
    date -d "$1" '+%G-W%V'
}

pax_org_previous_week() {
  date -v-7d '+%G-W%V' 2>/dev/null || date -d '7 days ago' '+%G-W%V'
}

if [ "$pax_org_mode" = "weekly" ] && [ -z "$pax_org_week" ]; then
  pax_org_week="$(pax_org_previous_week)"
fi

pax_org_prompt_file="$(mktemp "${TMPDIR:-/tmp}/pax-org-prompt.XXXXXX")"
pax_org_body_file="$(mktemp "${TMPDIR:-/tmp}/pax-org-body.XXXXXX")"
pax_org_error_file="$(mktemp "${TMPDIR:-/tmp}/pax-org-error.XXXXXX")"
pax_org_briefing_body="$(mktemp "${TMPDIR:-/tmp}/pax-org-briefing.XXXXXX")"
pax_org_candidates_body="$(mktemp "${TMPDIR:-/tmp}/pax-org-candidates.XXXXXX")"
pax_org_staged_file="$(mktemp "${TMPDIR:-/tmp}/pax-org-output.XXXXXX")"
pax_org_staged_candidates="$(mktemp "${TMPDIR:-/tmp}/pax-org-candidates-output.XXXXXX")"
trap 'rm -f "$pax_org_prompt_file" "$pax_org_body_file" "$pax_org_error_file" "$pax_org_briefing_body" "$pax_org_candidates_body" "$pax_org_staged_file" "$pax_org_staged_candidates"' EXIT

pax_org_note_files=()
if [ "$pax_org_mode" = "current" ]; then
  while IFS= read -r pax_org_note_file; do
    pax_org_note_files+=("$pax_org_note_file")
  done < <(find "$pax_org_daily_dir" -maxdepth 1 -type f -name '????-??-??.org' -print |
    sort -r | head -n "$pax_org_limit" | sort)
else
  while IFS= read -r pax_org_note_file; do
    pax_org_note_date="$(basename "$pax_org_note_file" .org)"
    if [ "$(pax_org_week_for_date "$pax_org_note_date")" = "$pax_org_week" ]; then
      pax_org_note_files+=("$pax_org_note_file")
    fi
  done < <(find "$pax_org_daily_dir" -maxdepth 1 -type f -name '????-??-??.org' -print | sort)
fi

if [ "${#pax_org_note_files[@]}" -eq 0 ]; then
  if [ "$pax_org_mode" = "weekly" ]; then
    echo "No daily notes found for $pax_org_week" >&2
  else
    echo "No daily notes found in $pax_org_daily_dir" >&2
  fi
  exit 2
fi

if [ "$pax_org_mode" = "weekly" ]; then
  pax_org_output_file="$pax_weekly_dir/$pax_org_week.md"
  pax_org_source_prefix="../../org/daily"
  pax_org_required_headings=(
    '## Week in review'
    '## Progress'
    '## Decisions and discoveries'
    '## Open threads'
    '## Knowledge candidates'
  )
  if [ -e "$pax_org_output_file" ] && [ "$pax_org_force" -ne 1 ]; then
    echo "Weekly snapshot already exists: $pax_org_output_file" >&2
    echo "Use --force to replace it." >&2
    exit 2
  fi
else
  pax_org_source_prefix="../org/daily"
  pax_org_required_headings=(
    '## Current focus'
    '## Unfinished threads'
    '## Decisions and discoveries'
    '## Patterns and suggestions'
    '## Knowledge candidates'
  )
fi

{
  if [ "$pax_org_mode" = "weekly" ]; then
    printf '%s\n' \
      "Synthesize the supplied work notes into a concise review of $pax_org_week." \
      'Return Markdown body text only. Use exactly these second-level headings:' \
      "${pax_org_required_headings[@]}"
  else
    printf '%s\n' \
      'Synthesize the supplied work notes into a concise current briefing.' \
      'Return Markdown body text only. Use exactly these second-level headings:' \
      "${pax_org_required_headings[@]}"
  fi
  printf '%s\n' \
    '' \
    'Use only evidence in the notes. Do not invent tasks, decisions, or context.' \
    'Unchecked checkboxes are candidates, not commitments. Completed checkboxes are historical.' \
    'Items under "* Unfinished" are carry-over candidates awaiting manual review, not current focus.' \
    'Completed descendants may be retained under an unfinished parent to preserve the parent task context.' \
    'Keep each section compact. Use bullets. Write "- None found." when unsupported.' \
    'Knowledge candidates are reusable decisions, concepts, or patterns worth promoting into curated notes.' \
    'Format each candidate as "- [ ] **Short title** — reason and source." Do not suggest routine tasks.' \
    'End each substantive bullet with a relative Markdown source link like:' \
    "[2026-08-03]($pax_org_source_prefix/2026-08-03.org)" \
    'Do not include frontmatter, a document title, commentary, or a code fence.'
  for pax_org_note_file in "${pax_org_note_files[@]}"; do
    pax_org_note_name="$(basename "$pax_org_note_file")"
    printf '\n--- SOURCE org/daily/%s ---\n' "$pax_org_note_name"
    sed -n '1,1200p' "$pax_org_note_file"
  done
} > "$pax_org_prompt_file"

if [ "$pax_org_prompt_only" -eq 1 ]; then
  cat "$pax_org_prompt_file"
  exit 0
fi

if [ ! -x "$pax_org_repo/bin/pi-wrapper/pi" ]; then
  echo "Pax Pi wrapper is missing at $pax_org_repo/bin/pi-wrapper/pi" >&2
  exit 2
fi

if ! direnv exec "$pax_org_repo" env \
  PI_CODING_AGENT_DIR="$pax_org_repo/src" \
  PAX_SRC_DIR="$pax_org_repo/src" \
  PAX_PI_RESOURCES_DIR="$pax_org_repo/packages/pi-resources" \
  "$pax_org_repo/bin/pi-wrapper/pi" \
  --print \
  --no-session \
  --no-tools \
  --no-skills \
  --no-prompt-templates \
  --no-context-files \
  --model "$pax_org_model" \
  --system-prompt 'You are a careful private work-note synthesizer. Follow the requested Markdown schema exactly.' \
  "@$pax_org_prompt_file" > "$pax_org_body_file" 2> "$pax_org_error_file"; then
  cat "$pax_org_error_file" >&2
  exit 1
fi

for pax_org_required_heading in "${pax_org_required_headings[@]}"; do
  if ! grep -Fqx "$pax_org_required_heading" "$pax_org_body_file"; then
    echo "Luna output omitted required heading: $pax_org_required_heading" >&2
    exit 1
  fi
done

pax_org_generated_at="$(date '+%Y-%m-%d %H:%M %Z')"
pax_org_write_frontmatter() {
  printf '%s\n' '---' "type: $1" "generated: $pax_org_generated_at"
  if [ -n "${2:-}" ]; then
    printf 'week: %s\n' "$2"
  fi
  printf 'sources:\n'
  for pax_org_note_file in "${pax_org_note_files[@]}"; do
    printf '  - %s\n' "$(basename "$pax_org_note_file" .org)"
  done
  printf '%s\n\n' '---'
}

mkdir -p "$pax_work_dir"
if [ "$pax_org_mode" = "weekly" ]; then
  mkdir -p "$pax_weekly_dir"
  {
    pax_org_write_frontmatter 'ai-weekly-synthesis' "$pax_org_week"
    printf '# Weekly Synthesis — %s\n\n' "$pax_org_week"
    printf '> AI-generated snapshot from raw Org daily notes. Edit only if you want to curate this record.\n\n'
    cat "$pax_org_body_file"
    printf '\n'
  } > "$pax_org_staged_file"
  mv "$pax_org_staged_file" "$pax_org_output_file"
  echo "Generated $pax_org_output_file"
else
  awk '/^## Knowledge candidates$/{exit} {print}' \
    "$pax_org_body_file" > "$pax_org_briefing_body"
  awk 'found {print} /^## Knowledge candidates$/{found=1}' \
    "$pax_org_body_file" > "$pax_org_candidates_body"
  {
    pax_org_write_frontmatter 'ai-work-briefing'
    printf '# Current Work Briefing\n\n'
    printf '> Rolling AI synthesis from raw Org daily notes. Regenerated in place.\n\n'
    printf '[Review knowledge candidates](Knowledge%%20Candidates.md)\n\n'
    cat "$pax_org_briefing_body"
  } > "$pax_org_staged_file"
  {
    pax_org_write_frontmatter 'ai-knowledge-candidates'
    printf '# Knowledge Candidates\n\n'
    printf '> AI suggestions only. Promote useful items manually into curated Obsidian notes.\n\n'
    cat "$pax_org_candidates_body"
  } > "$pax_org_staged_candidates"
  mv "$pax_org_staged_file" "$pax_current_file"
  mv "$pax_org_staged_candidates" "$pax_candidates_file"
  echo "Generated $pax_current_file"
  echo "Generated $pax_candidates_file"
fi
